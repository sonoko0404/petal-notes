<Window x:Class="StickyNotes.NoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" Height="320" MinWidth="260" MinHeight="240" ShowInTaskbar="False" Background="{DynamicResource Paper}" Title="便利贴">
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource Paper}">
    <Grid x:Name="Root">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="DragHeader" Margin="9,2,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Tint}" Width="56" Height="10" Opacity="0.8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,10,0" IsHitTestVisible="False"><Border.RenderTransform><RotateTransform Angle="-3"/></Border.RenderTransform></Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="✿" FontSize="17" Foreground="{DynamicResource Accent}" Margin="5,0,6,0"/>
          <TextBlock x:Name="HeaderLabel" Text="便利贴" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="＋" Style="{StaticResource IconButton}" ToolTip="新建便签 · Ctrl+N" Command="{Binding NewCommand}"/>
          <Button x:Name="PinButton" Content="●" Style="{StaticResource IconButton}" ToolTip="取消置顶" Command="{Binding PinCommand}" FontSize="11"/>
          <Button x:Name="FoldButton" Content="⌃" Style="{StaticResource IconButton}" ToolTip="折叠成标题条" Command="{Binding FoldCommand}"/>
          <Button Content="×" Style="{StaticResource IconButton}" ToolTip="隐藏便签（在托盘中恢复）" Command="{Binding HideCommand}"/>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,0,12,0">
        <StackPanel x:Name="EditorPanel" Margin="0,0,5,8">
          <Grid Margin="0,1,0,8">
            <TextBox x:Name="TitleInput" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="19" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0,4" MaxLength="200" AutomationProperties.Name="便签标题"/>
            <TextBlock Text="给这张便签起个名字" FontSize="17" Foreground="{DynamicResource Accent}" Opacity="0.55" IsHitTestVisible="False" Margin="0,4,0,0">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Title}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Grid>
            <TextBox x:Name="BodyInput" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="360" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" Padding="0,3" AutomationProperties.Name="便签正文" SpellCheck.IsEnabled="False"/>
            <TextBlock Text="记下一点灵感，或今天的小期待…" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Opacity="0.6" IsHitTestVisible="False" Margin="0,5,0,0">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Body}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <ItemsControl ItemsSource="{Binding Todos}" Margin="0,7,0,2">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="1,9,0,0" AutomationProperties.Name="待办完成状态"/>
                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="1,4" AutomationProperties.Name="待办内容">
                  <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                </TextBox>
                <Button Grid.Column="2" Content="×" Style="{StaticResource IconButton}" Width="23" VerticalAlignment="Top" ToolTip="移除这条待办" Command="{Binding DataContext.RemoveTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Opacity="0.55"/>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox x:Name="TodoInput" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}" Padding="1,5" FontSize="12" ToolTip="输入待办，按 Enter 添加" KeyDown="AddTodoKey" AutomationProperties.Name="添加待办"/>
          <TextBlock x:Name="TodoHint" Text="＋ 输入待办，按 Enter 添加" FontSize="11" Opacity="0.6" Margin="1,-25,0,8" IsHitTestVisible="False" Foreground="{DynamicResource Accent}"/>
        </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="SaveStatus" Grid.Row="2" Margin="17,0,15,3" FontSize="10" Foreground="{DynamicResource Muted}" Text="已保存到本机" TextTrimming="CharacterEllipsis"/>
      <Border x:Name="Footer" Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="12,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ReminderButton" Content="◷ 提醒" Background="Transparent" FontSize="11" Padding="5,6" Click="OpenReminder"/>
            <Button Content="◴ 专注" Background="Transparent" FontSize="11" Padding="7,6" Click="OpenFocus"/>
          </StackPanel>
          <Button Grid.Column="1" Content="•••" Style="{StaticResource IconButton}" Width="32" ToolTip="风格、字体与更多" Click="OpenMenu"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
