    "No items. Add some in Petal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No items. Add some in Petal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无内容。请在花瓣清单中添加。"
          }
        }
      }
    },
    "This card is archived. Edit the widget to choose another card.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card is archived. Edit the widget to choose another card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片已归档。请编辑小组件，选择其他卡片。"
          }
        }
      }
    },
    "This card is in Trash. Restore it in Petal or edit the widget.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card is in Trash. Restore it in Petal or edit the widget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片在回收站中。请在花瓣清单中恢复，或编辑小组件。"
          }
        }
      }
    },
    "Choose a card by editing this widget.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a card by editing this widget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
