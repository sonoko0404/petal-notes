    "This card is unavailable. Choose a card in Petal.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This card is unavailable. Choose a card in Petal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此卡片不可用。请在花瓣清单中选择卡片。"}}}},
