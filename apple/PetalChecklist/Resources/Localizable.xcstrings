    "Unable to save reminder. Your input is kept.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save reminder. Your input is kept."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法保存提醒，输入已保留。"}}}},
    "Reminder saved. Notifications are disabled in System Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder saved. Notifications are disabled in System Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒已保存。请在系统设置中启用通知。"}}}},
    "Reminder saved. Notification permission is needed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder saved. Notification permission is needed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒已保存，需要通知权限。"}}}},
    "Reminder saved. Scheduling failed. Save again to retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder saved. Scheduling failed. Save again to retry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒已保存，但调度失败。请再次保存以重试。"}}}},
