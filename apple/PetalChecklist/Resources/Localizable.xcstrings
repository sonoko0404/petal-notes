{
  "sourceLanguage" : "en",
  "strings" : {
    "Completing early may still allow today's reminder. Future daily reminders continue.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Completing early may still allow today's reminder. Future daily reminders continue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提前完成后，当天仍可能收到一次提醒。以后的每日提醒会继续。"}}}},
    "Open Notification Settings": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Notification Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开通知设置"}}}},
    "Unable to open System Settings. Open Notifications in System Settings manually.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to open System Settings. Open Notifications in System Settings manually."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法打开系统设置，请手动进入系统设置中的“通知”。"}}}},
    "Reminder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒"}}}},
    "Enable Reminder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Reminder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用提醒"}}}},
    "Repeat Daily": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Repeat Daily"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每天重复"}}}},
    "Reminder Time": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder Time"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒时间"}}}},
    "Unable to save reminder. Your input is kept.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save reminder. Your input is kept."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法保存提醒，输入已保留。"}}}},
    "Reminder saved. Notifications are disabled in System Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder saved. Notifications are disabled in System Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒已保存。请在系统设置中启用通知。"}}}},
    "Reminder saved. Notification permission is needed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder saved. Notification permission is needed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒已保存，需要通知权限。"}}}},
    "Reminder saved. Scheduling failed. Save again to retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder saved. Scheduling failed. Save again to retry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒已保存，但调度失败。请再次保存以重试。"}}}},
    "Reminder saved.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒已保存。"}}}},
    "Close": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Close"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭"}}}},
    "Remove Reminder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove Reminder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除提醒"}}}},
    "Save Reminder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save Reminder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存提醒"}}}},
    "Notification Sound": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notification Sound"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知声音"}}}},
    "Reminder scheduling failed. Open the reminder and save again to retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder scheduling failed. Open the reminder and save again to retry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒调度失败。请打开提醒并再次保存以重试。"}}}},
    "This Petal link is invalid.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Petal link is invalid."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此花瓣清单链接无效。"}}}},
    "This card is unavailable. Choose a card in Petal.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This card is unavailable. Choose a card in Petal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此卡片不可用。请在花瓣清单中选择卡片。"}}}},
    "Unable to open this card. Your draft has been kept. Please try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to open this card. Your draft has been kept. Please try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法打开此卡片。草稿已保留，请重试。"}}}},
    "Finish or cancel the current quick add before opening another card.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Finish or cancel the current quick add before opening another card."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请完成或取消当前快速新增，再打开其他卡片。"}}}},
