    "ui.notification_permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Petal uses notifications for reminders you choose to enable. Todo text may appear on your lock screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花瓣清单通过通知发送您主动启用的提醒。待办文字可能显示在锁屏上。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
