    "Data Transfer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Data Transfer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入与导出"}}}},
    "Import Windows Notes…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import Windows Notes…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入 Windows 便签…"}}}},
    "Export JSON Backup…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export JSON Backup…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 JSON 备份…"}}}},
    "Replace from Backup…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Replace from Backup…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从备份替换数据…"}}}},
    "Export Markdown Folder…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export Markdown Folder…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 Markdown 文件夹…"}}}},
    "Transferring Data…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transferring Data…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在传输数据…"}}}},
    "Transfer complete.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transfer complete."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据传输完成。"}}}},
    "Unable to transfer data. Check the file and destination, then retry. Markdown needs a new folder.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to transfer data. Check the file and destination, then retry. Markdown needs a new folder."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法传输数据，请检查文件和目标位置后重试。Markdown 需要一个新文件夹。"}}}},
    "Save Backup Before Import": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save Backup Before Import"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入前保存备份"}}}},
    "Daily reminders use this Mac’s time zone at import. A JSON backup is saved before importing.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily reminders use this Mac’s time zone at import. A JSON backup is saved before importing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每日提醒使用导入时此 Mac 的时区。导入前会保存 JSON 备份。"}}}},
    "Imported reminder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Imported reminder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入的提醒"}}}},
    "Replace Current Data?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Replace Current Data?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"替换当前数据？"}}}},
    "This replaces all cards, lines, and reminder sound settings with the backup. Changes sync to iCloud when enabled. Export a backup first if you want to keep the current data.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This replaces all cards, lines, and reminder sound settings with the backup. Changes sync to iCloud when enabled. Export a backup first if you want to keep the current data."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会用备份替换所有卡片、内容和提醒声音设置。启用 iCloud 时更改会同步。如需保留当前数据，请先导出备份。"}}}},
    "Replace Data": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Replace Data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"替换数据"}}}},
    "iCloud Sync": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud Sync"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iCloud 同步"}}}},
    "iCloud Sync Is Off": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud Sync Is Off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iCloud 同步已关闭"}}}},
    "Syncing with iCloud": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Syncing with iCloud"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在与 iCloud 同步"}}}},
    "Synced with iCloud": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Synced with iCloud"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已与 iCloud 同步"}}}},
    "Offline — Changes Are Saved Locally": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Offline — Changes Are Saved Locally"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"离线：更改已保存在本机"}}}},
    "iCloud Storage Is Full": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud Storage Is Full"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iCloud 储存空间已满"}}}},
    "Sign In to iCloud in System Settings": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign In to iCloud in System Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请在系统设置中登录 iCloud"}}}},
    "Unable to Sync. Try Again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to Sync. Try Again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法同步，请重试。"}}}},
    "Sync Now": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync Now"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"立即同步"}}}},
    "Conflicting edits were saved for 30 days.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Conflicting edits were saved for 30 days."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冲突编辑已保存，将保留 30 天。"}}}},
    "Dismiss Conflict Notice": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dismiss Conflict Notice"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭冲突提示"}}}},
    "Delete All Data…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete All Data…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除全部数据…"}}}},
    "Delete All Data": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete All Data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除全部数据"}}}},
    "Deleting all data creates an empty Inbox on your devices. Cloud changes finish when iCloud is available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deleting all data creates an empty Inbox on your devices. Cloud changes finish when iCloud is available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除全部数据后，各设备将创建一个空收集箱。iCloud 可用时会完成云端更改。"}}}},
    "A conflicting edit was preserved.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A conflicting edit was preserved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保留一份冲突编辑。"}}}},
    "Completing early may still allow today's reminder. Future daily reminders continue.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Completing early may still allow today's reminder. Future daily reminders continue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提前完成后，当天仍可能收到一次提醒。以后的每日提醒会继续。"}}}},
    "Open Notification Settings": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Notification Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开通知设置"}}}},
    "Unable to open System Settings. Open Notifications in System Settings manually.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to open System Settings. Open Notifications in System Settings manually."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法打开系统设置，请手动进入系统设置中的“通知”。"}}}},
    "Reminder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒"}}}},
